{
  "name": "payment-gateway-api",
  "version": "1.0.0",
  "description": "Payment gateway — REST API + hosted checkout page.",
  "homepage": "https://payment-gateway-docs.netlify.app",
  "bugs": {
    "url": "https://github.com/akshay-kumar-singh/payment-gateway-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshay-kumar-singh/payment-gateway-api.git"
  },
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node18 --clean",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
